# AI model provider. Use Gemini for the mobile Ask experience by default.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Optional fallback/provider switch:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-opus-5

# Local default:
DATABASE_URL=sqlite:///./astrospace.db
# Supabase Postgres example:
# DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Auth. When both are set, API routes require Supabase bearer tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Local visual QA only. Never set this in Cloud Run or another deployment.
# ASTROSPACE_DEV_AUTH_BYPASS=true
GEONAMES_USERNAME=anonymous

# Extra CORS origins (comma-separated). SPA is served same-origin in prod;
# only needed for local ng serve (defaulted) or a split frontend later.
# ALLOWED_ORIGINS=https://app.yourdomain.com
