{
  "hosting": {
    "public": "firebase-public",
    "ignore": ["firebase.json", "**/.*", "README.txt"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "agentic-astrospace", "region": "asia-south1" } },
      { "source": "/legal/**", "run": { "serviceId": "agentic-astrospace", "region": "asia-south1" } },
      { "source": "/email/**", "run": { "serviceId": "agentic-astrospace", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
      { "source": "/audio/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
