# Copy to android/keystore.properties (gitignored) to sign release builds.
# Paths are relative to ui/android. Generate the upload key once with:
#   keytool -genkeypair -v -keystore upload-key.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
# and enrol it in Play App Signing; Google holds the app signing key.
storeFile=upload-key.jks
storePassword=
keyAlias=upload
keyPassword=
