<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Supabase's session (including the refresh token) is kept in
         Keystore-wrapped secure storage (capacitor-secure-storage-plugin, see
         ui/src/app/core/session-storage.ts). Everything else the app persists
         — the SQLCipher cache of charts and guidance, preferences, the cached
         auth config — sits in the app's private files and SharedPreferences,
         which Auto Backup would copy to the user's Google account. Keep
         allowBackup off: a fresh install should start from the server, not
         from a backup of someone else's readings. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.asksiddha.mobile" android:host="auth" android:pathPrefix="/callback" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="agentic-astrospace-cwuqybpnzq-el.a.run.app"
                    android:pathPrefix="/api/v1/auth/native-callback"
                />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Pushes that name no channel still ring the temple bell; see MainActivity. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="siddha_bell" />

        <!-- Home-screen widgets; see widgets/Widgets.java. -->
        <receiver android:name=".widgets.TodayWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver android:name=".widgets.ListenWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_listen_info" />
        </receiver>
        <receiver android:name=".widgets.CalendarWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendar_info" />
        </receiver>
        <receiver android:name=".widgets.TimingWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timing_info" />
        </receiver>
        <receiver android:name=".widgets.MoonWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_moon_info" />
        </receiver>
        <receiver android:name=".widgets.MantraWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mantra_info" />
        </receiver>
        <receiver android:name=".widgets.AskWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ask_info" />
        </receiver>
        <receiver android:name=".widgets.SubhashitaWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_subhashita_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="app.asksiddha.mobile.widgets.REFRESH" />
            </intent-filter>
        </receiver>
        <!-- Reads today's brief aloud from the Listen widget (phone's own voice). -->
        <service
            android:name=".widgets.BriefSpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: requested at runtime by @capacitor/push-notifications from
         Settings > Notifications, never on launch (opt-in, never fear-based). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ask by voice (@capacitor-community/speech-recognition); requested at first use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The Listen widget reads the day's brief in a media-playback foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Widgets reschedule their next refresh after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
