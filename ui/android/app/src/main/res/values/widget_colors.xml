<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widgets, in the app's own palette (ui/src/styles-mobile.scss):
     cream and rust by day; values-night/ holds the dark one, deep brown with
     one gold accent, so widgets follow the phone's theme. -->
<resources>
    <color name="widget_bg_top">#FFFCF6</color>
    <color name="widget_bg_bottom">#F7EFE3</color>
    <color name="widget_raised">#F1E7D8</color>
    <color name="widget_text">#201A14</color>
    <color name="widget_muted">#756B5E</color>
    <!-- The one accent: rust by day, gold by night. -->
    <color name="widget_accent">#B13F2E</color>
    <color name="widget_on_accent">#FFF8EC</color>
    <color name="widget_gold">#7A5218</color>
    <color name="widget_track">#EADFCF</color>
    <!-- Day bands for the score ring: steady, mixed, take care. -->
    <color name="widget_band_steady">#2F7D57</color>
    <color name="widget_band_mixed">#A0661A</color>
    <color name="widget_band_tough">#B13F2E</color>
    <color name="widget_do">#2F7D57</color>
    <color name="widget_avoid">#B13F2E</color>
    <!-- The moon's unlit part. -->
    <color name="widget_moon_dark">#E7DCCB</color>
    <color name="widget_moon_lit">#C9A15A</color>
</resources>
