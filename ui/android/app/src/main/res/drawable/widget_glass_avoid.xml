<?xml version="1.0" encoding="utf-8"?>
<!-- The Today screen's tinted glass for Avoid: the tint fades into the glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/widget_bad_soft" android:endColor="@color/widget_bad_soft_end" />
            <stroke android:width="1dp" android:color="@color/widget_hairline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
