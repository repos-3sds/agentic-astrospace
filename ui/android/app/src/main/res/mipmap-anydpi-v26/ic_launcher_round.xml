<?xml version="1.0" encoding="utf-8"?>
<!-- Siddha Nine-Arm Galaxy, night form (space black). Layers are rendered from
     one master drawing (ui/scripts/brand); the galaxy sits inside the 66dp safe
     zone of the 108dp canvas. The monochrome layer drives Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
