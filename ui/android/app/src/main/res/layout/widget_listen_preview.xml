<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview only (previewLayout, Android 12+): the live
     layout is widget_listen_square.xml, whose text is all set at runtime. -->
<!-- Listen, 2x2 (the default): a big play button on the glass card, the
     kind of day and how long it takes. Hawk found the 4x1 bar too wide and
     too short (2026-10-21). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/eyebrow"
        style="@style/WidgetEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_listen_name"
        android:textColor="@color/widget_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/play"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/widget_accent_circle"
            android:contentDescription="@string/widget_listen_name"
            android:padding="16dp"
            android:src="@drawable/widget_ic_play" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_wave" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:text="Steady day"
            style="@style/WidgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/subtitle"
            android:text="About 1 min"
            style="@style/WidgetBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
