<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar as one day, 4x2: the date in a glass box, then the tithi,
     nakshatra, how the day is for you, and the next festival. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="78dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_glass"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weekday"
            style="@style/WidgetEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/day"
            style="@style/WidgetHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/month"
            style="@style/WidgetBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tithi"
            style="@style/WidgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/nakshatra"
            style="@style/WidgetBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/quality"
            style="@style/WidgetBand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/next"
            style="@style/WidgetBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_accent" />
    </LinearLayout>
</LinearLayout>
