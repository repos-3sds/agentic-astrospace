<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview only (previewLayout, Android 12+): the live
     layout is widget_calendar.xml, whose text is all set at runtime. -->
<!-- Calendar, medium: today's date and panchang, and what is coming. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minWidth="64dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weekday"
        android:text="SUN"
            style="@style/WidgetEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/day"
        android:text="18"
            style="@style/WidgetHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/month"
        android:text="October"
            style="@style/WidgetBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:background="@color/widget_track" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tithi"
        android:text="Shukla Saptami"
            style="@style/WidgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1" />

        <TextView
            android:id="@+id/nakshatra"
        android:text="Shravana nakshatra"
            style="@style/WidgetBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1" />

        <TextView
            android:id="@+id/next"
        android:text="Diwali · in 21 days · varies by tradition"
            style="@style/WidgetBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="2"
            android:textColor="@color/widget_gold" />
    </LinearLayout>
</LinearLayout>
