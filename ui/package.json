{
  "name": "ui",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "clean:generated": "node scripts/clean-generated-artifacts.mjs",
    "build": "node scripts/clean-generated-artifacts.mjs --before-web-build && ng build && node scripts/clean-generated-artifacts.mjs --after-web-build",
    "build:dev": "ng build --configuration development",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "sync:android": "node scripts/clean-generated-artifacts.mjs --before-cap-sync && npx cap sync android && node scripts/clean-generated-artifacts.mjs --after-cap-sync",
    "build:native": "npm run version:sync && npm run build && node scripts/clean-generated-artifacts.mjs --before-cap-sync && npx cap sync && node scripts/clean-generated-artifacts.mjs --after-cap-sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "build:native:dev": "npm run version:sync && node scripts/clean-generated-artifacts.mjs --before-web-build && ng build --configuration development && node scripts/clean-generated-artifacts.mjs --after-web-build && node scripts/clean-generated-artifacts.mjs --before-cap-sync && npx cap sync && node scripts/clean-generated-artifacts.mjs --after-cap-sync"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@primeuix/themes": "^2.0.3",
    "@supabase/supabase-js": "^2.110.3",
    "ag-grid-angular": "^34.3.1",
    "ag-grid-community": "^34.3.1",
    "lucide-angular": "^1.0.0",
    "marked": "^18.0.5",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.31",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
